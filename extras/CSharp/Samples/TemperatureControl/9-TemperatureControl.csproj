<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DataLogging</RootNamespace>
    <AssemblyName>DataLogging</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>annotations</Nullable>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8600;CS8601;CS8602;CS8603;CS8604</NoWarn>
  </PropertyGroup>
  <!-- ZedGraph: original project used ZedGraph.dll; replace with ScottPlot or similar for full .NET 8 support -->
  <ItemGroup>
    <ProjectReference Include="..\..\Transport\CommandMessenger.Transport.Bluetooth\CommandMessenger.Transport.Bluetooth.csproj" />
    <ProjectReference Include="..\..\Transport\CommandMessenger.Transport.Serial\CommandMessenger.Transport.Serial.csproj" />
    <ProjectReference Include="..\..\CommandMessenger\CommandMessenger.csproj" />
  </ItemGroup>
</Project>
